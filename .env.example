# Copy to .env and fill in. NEVER commit .env.

# --- Server ---
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Database ---
DATABASE_URL=postgres://mpus:PASSWORD@127.0.0.1:5432/mpus
DB_MAX_CONNECTIONS=10

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="MPUS <no-reply@booroong.online>"

# --- Sessions ---
SESSION_TTL_DAYS=60

# --- Avatar uploads (WebP) ---
UPLOAD_DIR=./uploads
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_DIMENSION=6000
AVATAR_WEBP_QUALITY=90

# --- Password hashing (argon2id) ---
# Lower memory on a tiny box; raise it if you have RAM to spare.
ARGON2_MEMORY_KIB=12288
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Email token lifetimes (seconds) ---
VERIFY_TOKEN_TTL_SECS=86400
RESET_TOKEN_TTL_SECS=3600

# --- Rate limits (max requests per window, window in seconds) ---
RATE_SIGNUP_MAX=5
RATE_SIGNUP_WINDOW_SECS=3600
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW_SECS=900
RATE_RESEND_MAX=3
RATE_RESEND_WINDOW_SECS=3600
RATE_FORGOT_MAX=5
RATE_FORGOT_WINDOW_SECS=3600

# --- Cat embedding model (MegaDescriptor-T / Swin-Tiny, 768-d) ---
# Export it with tools/export_onnx.py (see that file's header).
EMBED_MODEL_PATH=./models/megadescriptor-t-224-int8.onnx
EMBED_THREADS=1
EMBED_ARENA=false
EMBED_TOP_K=5

# --- Cat photo uploads ---
SIGHTING_MAX_BYTES=10485760
SIGHTING_MAX_DIMENSION=8000
SIGHTING_WEBP_QUALITY=90
SIGHTING_THUMB_MAX_DIM=512

# --- Rate limits: sightings (max requests per window, window in seconds) ---
RATE_SIGHTING_MAX=30
RATE_SIGHTING_WINDOW_SECS=3600

# --- Rate limits: other writes (names, reviews, likes, profile, reports) ---
RATE_WRITE_MAX=60
RATE_WRITE_WINDOW_SECS=600

# --- Push notifications (FCM HTTP v1) ---
# Path to a Firebase service-account JSON. Leave unset to disable push entirely.
# FCM_SERVICE_ACCOUNT_JSON=/home/sana/mpus/fcm-service-account.json
